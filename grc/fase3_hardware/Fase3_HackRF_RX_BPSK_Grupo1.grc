    ctrlpanel: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 560
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: 'Frecuencia RF central: banda ISM 902-928 MHz (Region 2). Confirmar con el docente.'
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 620
    rotation: 0
    state: enabled
- name: fll
  id: digital_fll_band_edge_cc
  parameters:
    comment: Corrige el offset de frecuencia entre radios
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    filter_size: '44'
    rolloff: beta
    samps_per_sym: Sps
    type: cc
    w: 2*math.pi/400
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 330
    rotation: 0
    state: enabled
- name: hackrf_source
  id: osmosdr_source
  parameters:
    comment: 'LO en fc + lo_off: la senal aparece en -lo_off'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    args: '"hackrf=0"'
    sample_rate: radio_rate
    freq0: fc + lo_off
    corr0: '0'
    dc_offset_mode0: '0'
    iq_balance_mode0: '0'
    gain_mode0: 'False'
    gain0: '0'
    if_gain0: rx_lna
    bb_gain0: rx_vga
    ant0: '""'
    bw0: '0'
    nchan: '1'
    num_mboards: '1'
    sync: none
    type: fc32
    clock_source0: ''
    time_source0: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 330
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1058
    - 220
    rotation: 0
    state: enabled
- name: impulsos
  id: blocks_vector_source_x
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: complex
    vector: '[0j]*(periodo_imp-1) + [complex(A_imp, 0)]'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 430
    - 450
    rotation: 0
    state: enabled
- name: interp
  id: variable
  parameters:
    comment: radio_rate = samp_rate * interp / decim

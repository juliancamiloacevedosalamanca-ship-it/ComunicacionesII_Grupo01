  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '1'
    type: float
    vlen: '1'
    bus_structure_sink: '[[0,],]'
  states:

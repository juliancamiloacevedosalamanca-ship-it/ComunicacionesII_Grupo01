    gui_hint: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1250
    - 212
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: bb_rate = Rs*Sps = 256 kS/s
    value: Rs*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 408
    - 110
    rotation: 0
    state: enabled
- name: span
  id: variable
  parameters:
    comment: Longitud del RRC en simbolos
    value: '11'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 408
    - 220
    rotation: 0
    state: enabled
- name: suma_impulsos
  id: blocks_add_xx
  parameters:
    comment: Modelo de ruido impulsivo del proyecto
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 640
    - 350
    rotation: 0
    state: enabled
- name: tabla_de_verdad_constelacion
  id: variable
  parameters:
    comment: 'BPSK: bit 0 -> -1, bit 1 -> +1'
    value: (-1+0j, 1+0j)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 608
    - 110
    rotation: 0
    state: enabled
connections:
- - hackrf_source
  - '0'
  - desplaza_lo
  - '0'
- - desplaza_lo
  - '0'
  - adapta_tasa
  - '0'
- - adapta_tasa

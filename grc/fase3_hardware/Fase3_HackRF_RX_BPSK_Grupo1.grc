- name: radio_rate
  id: variable
  parameters:
    comment: Tasa de muestreo del SDR
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 310
    - 620
    rotation: 0
    state: enabled
- name: rrc_rx_ojo
  id: fir_filter_xxx
  parameters:
    comment: 'Solo diagnostico: ojo'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    decim: '1'
    taps: rrc_rx_taps
    type: ccf
    samp_delay: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 830
    - 560
    rotation: 0
    state: enabled
- name: rrc_rx_taps
  id: variable
  parameters:
    comment: 'Filtro acoplado: RRC normalizado por su energia -> pico de decision = +-1'
    value: '[t/sum(x*x for x in rrc_tx_taps) for t in rrc_tx_taps]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1208
    - 110
    rotation: 0
    state: enabled
- name: rrc_tx_taps
  id: variable_rrc_filter_taps
  parameters:
    comment: 'RRC Tx: ganancia Sps -> nivel de simbolo ~1 (GNU Radio fuerza 89 taps impares)'
    gain: Sps
    samp_rate: samp_rate
    sym_rate: Rs
    alpha: beta
    ntaps: span*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 808
    - 220
    rotation: 0
    state: enabled
- name: rx_lna
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: HackRF RX LNA/IF gain (0-40 dB, pasos de 8)

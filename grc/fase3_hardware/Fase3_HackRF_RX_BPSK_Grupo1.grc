- name: null_fll
  id: blocks_null_sink
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '3'
    type: float
    vlen: '1'
    bus_structure_sink: '[[0,],]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1200
    - 450
    rotation: 0
    state: enabled
- name: null_pfb
  id: blocks_null_sink
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '3'
    type: float
    vlen: '1'
    bus_structure_sink: '[[0,],]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1420
    - 560
    rotation: 0
    state: enabled
- name: periodo_imp
  id: variable
  parameters:
    comment: 1 impulso cada 256 muestras = 1 ms
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 608
    - 220
    rotation: 0
    state: enabled
- name: pfb_sync
  id: digital_pfb_clock_sync_xxx
  parameters:
    comment: Filtro acoplado RRC + recuperacion de reloj
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    filter_size: nfilts
    init_phase: nfilts/2
    loop_bw: 2*math.pi/100
    max_dev: '1.5'
    osps: '1'
    sps: Sps
    taps: firdes.root_raised_cosine(nfilts, nfilts*samp_rate, Rs, beta, span*Sps*nfilts)
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1200
    - 330
    rotation: 0
    state: enabled
- name: psd_rx_radio
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: radio_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'

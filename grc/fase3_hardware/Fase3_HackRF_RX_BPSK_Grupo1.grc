options:
  parameters:
    author: Grupo 1
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: SDR -> desplazamiento LO -> adaptacion radio_rate -> bb_rate -> [impulsos del proyecto] -> AGC -> FLL -> PFB (filtro acoplado + reloj) -> Costas -> decision -> decodificacion diferencial -> bits.
    copyright: ''
    description: Receptor del proyecto conectado a hardware SDR
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: Fase3_HackRF_RX_BPSK_Grupo1
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Fase 3 - RX BPSK con HackRF - Grupo 1
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: A_imp
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: Impulsos del proyecto inyectados en Rx (A_imp)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '10'
    value: '0'
    widget: counter_slider
    gui_hint: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1250
    - 8
    rotation: 0
    state: enabled
- name: M
  id: variable
  parameters:
    comment: ''
    value: len(tabla_de_verdad_constelacion)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 808
    - 110
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: Rb = 32 kb/s
    value: Rs*bps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 220
    rotation: 0
    state: enabled
- name: Rs
  id: variable
  parameters:
    comment: Tasa de simbolos [sym/s]
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 110
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    comment: Muestras por simbolo
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 208
    - 110
    rotation: 0
    state: enabled
- name: adapta_tasa
  id: rational_resampler_xxx
  parameters:
    comment: radio_rate -> bb_rate (256 kS/s)
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    interp: interp
    decim: decim
    taps: '[]'
    fbw: '0'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 430
    - 330
    rotation: 0
    state: enabled
- name: agc
  id: analog_agc_xx
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    gain: '1.0'
    max_gain: '500'
    rate: 1e-3
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 830
    - 330
    rotation: 0
    state: enabled
- name: beta
  id: variable
  parameters:
    comment: Roll-off RRC
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 208
    - 220
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters:
    comment: ''
    value: int(math.log(M,2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1008
    - 110
    rotation: 0
    state: enabled
- name: const_bpsk
  id: variable_constellation
  parameters:
    comment: ''
    const_points: tabla_de_verdad_constelacion
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '2'
    soft_dec_lut: None
    sym_map: '[0, 1]'
    type: calcdist
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1208
    - 220
    rotation: 0
    state: enabled
- name: const_rx
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    grid: 'True'
    gui_hint: ''
    label1: '""'
    label10: '""'
    label2: '""'
    label3: '""'
    label4: '""'
    label5: '""'
    label6: '""'
    label7: '""'
    label8: '""'
    label9: '""'
    legend: 'False'
    marker1: '0'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Constelacion recuperada (tras PFB + Costas)"'
    nconnections: '1'
    size: '1024'
    style1: '0'
    style10: '0'
    style2: '0'
    style3: '0'
    style4: '0'
    style5: '0'
    style6: '0'
    style7: '0'
    style8: '0'
    style9: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1600
    - 330
    rotation: 0
    state: enabled
- name: costas
  id: digital_costas_loop_cc
  parameters:
    comment: Recuperacion de fase de portadora (BPSK)
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '2'
    use_snr: 'False'
    w: 2*math.pi/100
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1420
    - 330
    rotation: 0
    state: enabled
- name: dec_diferencial
  id: digital_diff_decoder_bb
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    modulus: '2'
    coding: digital.DIFF_DIFFERENTIAL
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1600
    - 450
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: ''
    value: '125'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 610
    - 620
    rotation: 0
    state: enabled
- name: decision
  id: digital_constellation_decoder_cb
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    constellation: const_bpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1420
    - 450
    rotation: 0
    state: enabled
- name: desplaza_lo
  id: freq_xlating_fir_filter_xxx
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    center_freq: -lo_off
    decim: '1'
    samp_rate: radio_rate
    taps: '[1]'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 330
    rotation: 0
    state: enabled
- name: diagrama_ojo
  id: qtgui_eye_sink_x
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Diagrama de ojo (filtro acoplado, sin recuperar portadora)"'
    gui_hint: ''
    samp_per_symbol: Sps
    size: '1024'
    srate: samp_rate
    type: complex
    nconnections: '1'
    ymin: '-1.6'
    ymax: '1.6'
    autoscale: 'False'
    update_time: '0.10'
    grid: 'True'
    entags: 'True'
    legend: 'True'
    axislabels: 'True'
    label1: I
    label2: Q
    ylabel: Amplitud
    yunit: '""'
    tr_mode: qtgui.TRIG_MODE_FREE

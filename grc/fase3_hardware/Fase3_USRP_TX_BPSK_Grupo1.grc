options:
  parameters:
    author: Grupo 1
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Copia para hardware del transmisor simulado. Sin Throttle: el SDR fija el ritmo. bb_rate = 256 kS/s -> resampler -> radio_rate. Prueba primero por cable con atenuacion.'
    copyright: ''
    description: Transmisor del proyecto conectado a hardware SDR
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: Fase3_USRP_TX_BPSK_Grupo1
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Fase 3 - TX BPSK con USRP (UHD: USRP Sink) - Grupo 1'
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: M
  id: variable
  parameters:
    comment: ''
    value: len(tabla_de_verdad_constelacion)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 808
    - 110
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: Rb = 32 kb/s
    value: Rs*bps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 220
    rotation: 0
    state: enabled
- name: Rs
  id: variable
  parameters:
    comment: Tasa de simbolos [sym/s]
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 110
    rotation: 0
    state: enabled
- name: Sps
  id: variable
  parameters:
    comment: Muestras por simbolo
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 208
    - 110
    rotation: 0
    state: enabled
- name: adapta_tasa
  id: rational_resampler_xxx
  parameters:
    comment: bb_rate -> radio_rate
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    interp: interp
    decim: decim
    taps: '[]'
    fbw: '0'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 960
    - 330
    rotation: 0
    state: enabled
- name: beta
  id: variable
  parameters:
    comment: Roll-off RRC
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 208
    - 220
    rotation: 0
    state: enabled
- name: bps
  id: variable
  parameters:
    comment: ''
    value: int(math.log(M,2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1008
    - 110
    rotation: 0
    state: enabled
- name: cod_diferencial
  id: digital_diff_encoder_bb
  parameters:
    comment: 'Codificacion diferencial: resuelve la ambiguedad de 180 grados del lazo de portadora'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    modulus: '2'
    coding: digital.DIFF_DIFFERENTIAL
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 178
    - 530
    rotation: 0
    state: enabled
- name: const_bpsk
  id: variable_constellation
  parameters:
    comment: ''
    const_points: tabla_de_verdad_constelacion
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '2'
    soft_dec_lut: None
    sym_map: '[0, 1]'
    type: calcdist
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1208
    - 220
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: ''
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 610
    - 620
    rotation: 0
    state: enabled
- name: desplaza_lo
  id: freq_xlating_fir_filter_xxx
  parameters:
    comment: Senal en +lo_off; LO del radio en fc - lo_off -> RF en fc
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    center_freq: -lo_off
    decim: '1'
    samp_rate: radio_rate
    taps: '[1]'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 330
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: 'Frecuencia RF central: banda ISM 902-928 MHz (Region 2). Confirmar con el docente.'
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 620
    rotation: 0
    state: enabled
- name: fuente_bits
  id: digital_glfsr_source_x
  parameters:
    comment: PRBS-15 (secuencia conocida, repetible en Tx y Rx)
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: byte
    degree: '15'
    mask: '0'
    repeat: 'True'
    seed: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 420
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    comment: ''
    imports: import math
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1058
    - 220
    rotation: 0
    state: enabled
- name: interp
  id: variable
  parameters:
    comment: radio_rate = samp_rate * interp / decim
    value: '125'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 460
    - 620
    rotation: 0
    state: enabled
- name: iq_tx_radio
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: ''
    ctrlpanel: 'False'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: I
    label10: Signal 10
    label2: Q
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"I/Q enviados al SDR"'
    nconnections: '1'
    size: '2048'
    srate: radio_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Amplitude
    ymax: '1'
    ymin: '-1'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 560
    rotation: 0
    state: enabled
- name: lo_off
  id: variable
  parameters:
    comment: Desplazamiento del LO para alejar la senal de la espiga DC
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 160
    - 620
    rotation: 0
    state: enabled
- name: mapeo_bpsk
  id: digital_chunks_to_symbols_xx
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    dimension: '1'
    in_type: byte
    num_ports: '1'
    out_type: complex
    symbol_table: tabla_de_verdad_constelacion
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 368
    - 420
    rotation: 0
    state: enabled
- name: periodo_imp
  id: variable
  parameters:
    comment: 1 impulso cada 256 muestras = 1 ms
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 608
    - 220
    rotation: 0
    state: enabled
- name: psd_tx_radio
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: radio_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '4096'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: ''
    label: Relative Gain
    label1: Senal
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"PSD Tx a radio_rate (senal en +lo_off)"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 450
    rotation: 0
    state: enabled
- name: radio_rate
  id: variable
  parameters:
    comment: Tasa de muestreo del SDR
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 310
    - 620
    rotation: 0
    state: enabled
- name: rrc_rx_taps
  id: variable
  parameters:
    comment: 'Filtro acoplado: RRC normalizado por su energia -> pico de decision = +-1'
    value: '[t/sum(x*x for x in rrc_tx_taps) for t in rrc_tx_taps]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1208
    - 110
    rotation: 0
    state: enabled
- name: rrc_tx
  id: interp_fir_filter_xxx
  parameters:
    comment: Conformacion de pulso RRC (Tx)
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    interp: Sps
    taps: rrc_tx_taps
    type: ccf
    samp_delay: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 608
    - 420
    rotation: 0
    state: enabled
- name: rrc_tx_taps
  id: variable_rrc_filter_taps
  parameters:
    comment: 'RRC Tx: ganancia Sps -> nivel de simbolo ~1 (GNU Radio fuerza 89 taps impares)'
    gain: Sps
    samp_rate: samp_rate
    sym_rate: Rs
    alpha: beta
    ntaps: span*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 808
    - 220
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: bb_rate = Rs*Sps = 256 kS/s
    value: Rs*Sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 408
    - 110
    rotation: 0
    state: enabled
- name: span
  id: variable
  parameters:
    comment: Longitud del RRC en simbolos
    value: '11'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 408
    - 220
    rotation: 0
    state: enabled
- name: tabla_de_verdad_constelacion
  id: variable
  parameters:
    comment: 'BPSK: bit 0 -> -1, bit 1 -> +1'
    value: (-1+0j, 1+0j)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 608
    - 110
    rotation: 0
    state: enabled
- name: tx_amp
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: Amplitud digital Tx (pico < 1)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.01'
    step: '0.01'
    stop: '1.0'
    value: '0.5'
    widget: counter_slider
    gui_hint: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1250
    - 8
    rotation: 0
    state: enabled
- name: tx_escala
  id: blocks_multiply_const_vxx
  parameters:
    comment: 'Evita saturar el DAC: |x| < 1'
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    const: tx_amp
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 780
    - 330
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: USRP TX gain [dB]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '60'
    value: '20'
    widget: counter_slider
    gui_hint: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1250
    - 110
    rotation: 0
    state: enabled
- name: usrp_sink
  id: uhd_usrp_sink
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: fc32
    otw: sc16
    dev_addr: '""'
    dev_args: '""'
    sync: none
    num_mboards: '1'
    nchan: '1'
    samp_rate: radio_rate
    center_freq0: fc - lo_off
    gain0: tx_gain
    gain_type0: default
    norm_gain0: 'False'
    ant0: '"TX/RX"'
    bw0: '0'
    clock_source0: internal
    time_source0: ''
    len_tag_name: '""'
    start_time: '-1.0'
    show_lo_controls: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1400
    - 320
    rotation: 0
    state: enabled
connections:
- - fuente_bits
  - '0'
  - cod_diferencial
  - '0'
- - cod_diferencial
  - '0'
  - mapeo_bpsk
  - '0'
- - mapeo_bpsk
  - '0'
  - rrc_tx
  - '0'
- - rrc_tx
  - '0'
  - tx_escala
  - '0'
- - tx_escala
  - '0'
  - adapta_tasa
  - '0'
- - adapta_tasa
  - '0'
  - desplaza_lo
  - '0'
- - desplaza_lo

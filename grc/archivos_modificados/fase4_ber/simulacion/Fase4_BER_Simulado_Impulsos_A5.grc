    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: "\"\"\"\ne_Busca_Retardo (Grupo 1)\nHerramienta de apoyo para calibrar delay_bits en el laboratorio.\n\nEntrada 0 : bits Tx de referencia (byte 0/1).\nEntrada 1 : bits Rx recuperados (byte 0/1).\n\nAcumula 'n_bits' de cada secuencia y calcula, por correlación cruzada (FFT),\nel retardo (en bits) que mejor alinea Rx con Tx, entre 0 y 'max_lag'.\nImprime en la consola de GNU Radio el retardo y la BER en ese retardo.\nSi la correlación es negativa, los bits llegan invertidos (ambigüedad de 180°).\nSe repite cada 'n_bits' bits.\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self, n_bits=40000, max_lag=33000):\n        gr.sync_block.__init__(self, name='e_Busca_Retardo',\n                               in_sig=[np.int8, np.int8], out_sig=None)\n        self.n_bits = int(n_bits)\n        self.max_lag = int(max_lag)\n        self.tx = []\n        self.rx = []\n        self.total = self.n_bits + self.max_lag\n\n    def work(self, input_items, output_items):\n        self.tx.extend((input_items[0] & 1).tolist())\n        self.rx.extend((input_items[1] & 1).tolist())\n        if len(self.tx) >= self.total and len(self.rx) >= self.total:\n            tx = 2.0*np.array(self.tx[:self.total]) - 1.0\n            rx = 2.0*np.array(self.rx[self.max_lag:self.total]) - 1.0\n            n = 1 << int(np.ceil(np.log2(len(tx) + len(rx))))\n            corr = np.fft.irfft(np.fft.rfft(tx, n) * np.conj(np.fft.rfft(rx, n)), n)\n            c = corr[:self.max_lag + 1][::-1] / len(rx)\n            k = int(np.argmax(np.abs(c)))\n            lag = k\n            ref = tx[self.max_lag - lag:self.max_lag - lag + len(rx)]\n            ber = float(np.mean(np.sign(ref) != np.sign(rx)))\n            print(f\"[e_Busca_Retardo] delay_bits = {lag}  correlacion = {c[k]:+.3f}  BER en ese retardo = {ber:.3e}\"\n                  + (\"  (bits INVERTIDOS)\" if c[k] < 0 else \"\"))\n            self.tx = self.tx[self.total:]\n            self.rx = self.rx[self.total:]\n        return len(input_items[0])\n"
    n_bits: '40000'
    max_lag: '33000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1700
    - 1040
    rotation: 0
    state: enabled
    _io_cache: ('e_Busca_Retardo', 'blk', [('n_bits', '40000'), ('max_lag', '33000')], [('0', 'byte', 1), ('1', 'byte', 1)], [], '', ['max_lag', 'n_bits'])
- name: e_EbN0_Sweep
  id: epy_block
  parameters:
    comment: ''
    affinity: ''
    alias: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: "\"\"\"\ne_EbN0_Sweep\nInstrumento para caracterización BER con un enlace SDR ya funcional.\n\nEntrada 0 : señal compleja I/Q recibida del SDR (preferiblemente DESPUÉS\n            de la adaptación radio_rate -> bb_rate).\nSalida 0  : la misma señal I/Q con AWGN adicional controlado.\nSalida 1  : valor instantáneo de Eb/N0 [dB] usado en el barrido.\n\nEl bloque NO sustituye el USRP/HackRF ni el receptor. Se inserta entre\nla salida I/Q del SDR y la entrada del receptor digital.\n\nEl barrido se hace por segmentos contiguos. Cada punto se mantiene durante:\n    bits_guardia + bits_por_punto\n\nLa potencia de ruido artificial se calcula a partir de la potencia promedio\nmedida ANTES de agregar el ruido:\n\n    Eb = Ps / Rb\n    N0 = Eb / (Eb/N0)\n    Pn = N0 * Fs\n\npor lo tanto:\n\n    Pn = Ps * Fs / (Rb * 10**(EbN0_dB/10))\n\nEl ruido complejo se genera con varianza total Pn.\n\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\n                 EbN0_min=0.0,\n                 EbN0_max=14.0,\n                 EbN0_step=1.0,\n                 samp_rate=256000.0,\n                 bit_rate=64000.0,\n                 bits_por_punto=100000,\n                 bits_guardia=1000,\n                 signal_power=0.0,\n                 seed=2026):\n        gr.sync_block.__init__(\n            self,\n            name='e_EbN0_Sweep',\n            in_sig=[np.complex64],\n            out_sig=[np.complex64, np.float32]\n        )\n\n        self.EbN0_min = float(EbN0_min)\n        self.EbN0_max = float(EbN0_max)\n        self.EbN0_step = float(EbN0_step)\n        self.samp_rate = float(samp_rate)\n        self.bit_rate = float(bit_rate)\n        self.bits_por_punto = max(1, int(bits_por_punto))\n        self.bits_guardia = max(0, int(bits_guardia))\n        self.signal_power_cfg = float(signal_power)\n\n        if self.EbN0_step <= 0:\n            raise ValueError(\"EbN0_step debe ser > 0\")\n        if self.samp_rate <= 0 or self.bit_rate <= 0:\n            raise ValueError(\"samp_rate y bit_rate deben ser > 0\")\n        if self.EbN0_max < self.EbN0_min:\n            raise ValueError(\"EbN0_max debe ser >= EbN0_min\")\n\n        npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step)) + 1\n        self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts, dtype=np.float64)\n        self.segment_bits = self.bits_guardia + self.bits_por_punto\n\n        self.sample_count = 0\n        self.power_sum = 0.0\n        self.power_count = 0\n        self.rng = np.random.default_rng(int(seed))\n\n    def _signal_power(self, x):\n        if self.signal_power_cfg > 0:\n            return self.signal_power_cfg\n\n        # Promedio acumulado de la señal recibida ANTES del ruido artificial.\n        self.power_sum += float(np.sum(np.abs(x.astype(np.complex128))**2))\n        self.power_count += len(x)\n        if self.power_count <= 0:\n            return 0.0\n        return max(self.power_sum/self.power_count, 1e-20)\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n        y = output_items[0]\n        eb_out = output_items[1]\n        n = len(x)\n        if n == 0:\n            return 0\n\n        Ps = self._signal_power(x)\n\n        # Índice absoluto de muestra -> índice equivalente de bit.\n        s = self.sample_count + np.arange(n, dtype=np.float64)\n        bit_index = np.floor(s*self.bit_rate/self.samp_rate).astype(np.int64)\n\n        segment_index = bit_index // self.segment_bits\n        point_index = np.mod(segment_index, len(self.eb_axis))\n        ebn0_db = self.eb_axis[point_index]\n        ebn0_lin = np.power(10.0, ebn0_db/10.0)\n\n        # Potencia total del ruido complejo por muestra.\n        noise_power = Ps*self.samp_rate/(self.bit_rate*ebn0_lin)\n        sigma_iq = np.sqrt(np.maximum(noise_power, 0.0)/2.0)\n\n        noise = (\n            self.rng.standard_normal(n)*sigma_iq\n            + 1j*self.rng.standard_normal(n)*sigma_iq\n        ).astype(np.complex64)\n\n        y[:] = x + noise\n        eb_out[:] = ebn0_db.astype(np.float32)\n\
      \n        self.sample_count += n\n        return n\n"
    EbN0_min: EbN0_min
    EbN0_max: EbN0_max
    EbN0_step: EbN0_step
    samp_rate: samp_rate
    bit_rate: Rb
    bits_por_punto: bits_por_punto
    bits_guardia: bits_guardia
    signal_power: '0.0'
    seed: '2026'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 900
    - 820
    rotation: 0
    state: enabled
    _io_cache: ('e_EbN0_Sweep', 'blk', [('EbN0_min', '0.0'), ('EbN0_max', '14.0'), ('EbN0_step', '1.0'), ('samp_rate', '256000.0'), ('bit_rate', '64000.0'), ('bits_por_punto', '100000'), ('bits_guardia', '1000'), ('signal_power', '0.0'), ('seed', '2026')], [('0', 'complex', 1)], [('0', 'complex', 1), ('1', 'float', 1)], '', ['EbN0_max', 'EbN0_min', 'EbN0_step', 'bit_rate', 'bits_guardia', 'bits_por_punto', 'samp_rate'])

options:
  parameters:
    author: Grupo 1
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Referencia simulada: mismo Tx/Rx (BPSK diferencial) que el enlace
      HackRF/USRP, sin hardware'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: Fase4_BER_Simulado_BPSK_Grupo1
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Fase 4 - Curva BER vs Eb/N0 simulada (referencia) - Grupo 1
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1032, 192.0]
    rotation: 0
    state: enabled


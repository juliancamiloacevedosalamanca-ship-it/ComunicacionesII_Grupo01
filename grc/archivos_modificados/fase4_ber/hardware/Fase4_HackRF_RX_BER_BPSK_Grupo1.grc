- name: e_BER_Curve
  id: epy_block
  parameters:
    EbN0_max: EbN0_max
    EbN0_min: EbN0_min
    EbN0_step: EbN0_step
    _source_code: "\"\"\"\ne_BER_Curve\nAcumulador de curva BER para los sistemas\
      \ de los estudiantes.\n\nEntrada 0 : bits transmitidos de referencia (byte 0/1).\n\
      Entrada 1 : bits recuperados por el receptor (byte 0/1).\n\nSalida 0  : vector\
      \ BER lineal.\nSalida 1  : vector log10(BER) para QT GUI Vector Sink.\n\nEl\
      \ bloque usa exactamente el mismo barrido que e_EbN0_Sweep. Para cada punto:\n\
      - ignora bits_guardia al comienzo del segmento;\n- compara bits_por_punto;\n\
      - cuando el barrido vuelve a un punto, sigue acumulando estad\xEDsticas.\n\n\
      delay_bits retrasa internamente la referencia Tx para compensar el retardo\n\
      del receptor. Se ajusta primero en una condici\xF3n limpia hasta lograr BER\u2248\
      0.\n\nCuando todav\xEDa no se observa ning\xFAn error, la salida logar\xEDtmica\
      \ utiliza\n3/N como cota superior aproximada para poder mostrar el punto sin\
      \ afirmar\nque BER=0.\n\"\"\"\n\nimport numpy as np\nfrom collections import\
      \ deque\nfrom gnuradio import gr\n\n\nclass blk(gr.decim_block):  # decim_block:\
      \ clase Python que GRC 3.10 reconoce\n    def __init__(self,\n             \
      \    EbN0_min=0.0,\n                 EbN0_max=14.0,\n                 EbN0_step=1.0,\n\
      \                 bits_por_punto=100000,\n                 bits_guardia=1000,\n\
      \                 delay_bits=0,\n                 update_every=1000):\n    \
      \    self.EbN0_min = float(EbN0_min)\n        self.EbN0_max = float(EbN0_max)\n\
      \        self.EbN0_step = float(EbN0_step)\n        self.bits_por_punto = max(1,\
      \ int(bits_por_punto))\n        self.bits_guardia = max(0, int(bits_guardia))\n\
      \        self.delay_bits = max(0, int(delay_bits))\n        self.update_every\
      \ = max(1, int(update_every))\n\n        if self.EbN0_step <= 0:\n         \
      \   raise ValueError(\"EbN0_step debe ser > 0\")\n        if self.EbN0_max <\
      \ self.EbN0_min:\n            raise ValueError(\"EbN0_max debe ser >= EbN0_min\"\
      )\n\n        npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step))\
      \ + 1\n        self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts,\
      \ dtype=np.float64)\n        self.N = len(self.eb_axis)\n        self.segment_bits\
      \ = self.bits_guardia + self.bits_por_punto\n\n        gr.decim_block.__init__(\n\
      \            self,\n            name='e_BER_Curve',\n            in_sig=[np.int8,\
      \ np.int8],\n            out_sig=[(np.float32, self.N), (np.float32, self.N)],\n\
      \            decim=self.update_every\n        )\n\n        self.tx_fifo = deque([0]*self.delay_bits)\n\
      \        self.raw_items = 0\n        self.valid_bit_index = 0\n\n        self.count\
      \ = np.zeros(self.N, dtype=np.int64)\n        self.errors = np.zeros(self.N,\
      \ dtype=np.int64)\n\n    def _process(self, tx, rx):\n        for t, r in zip(tx,\
      \ rx):\n            tb = int(t) & 1\n            rb = int(r) & 1\n\n       \
      \     if self.delay_bits > 0:\n                self.tx_fifo.append(tb)\n   \
      \             t_aligned = self.tx_fifo.popleft()\n                if self.raw_items\
      \ < self.delay_bits:\n                    self.raw_items += 1\n            \
      \        continue\n            else:\n                t_aligned = tb\n\n   \
      \         bit_index = self.valid_bit_index\n            segment_index = bit_index\
      \ // self.segment_bits\n            point_index = segment_index % self.N\n \
      \           pos = bit_index % self.segment_bits\n\n            # Dejar que filtros/sincronizadores\
      \ se estabilicen despu\xE9s\n            # del cambio de nivel de ruido.\n \
      \           if pos >= self.bits_guardia:\n                self.count[point_index]\
      \ += 1\n                if t_aligned != rb:\n                    self.errors[point_index]\
      \ += 1\n\n            self.valid_bit_index += 1\n            self.raw_items\
      \ += 1\n\n    def _vectors(self):\n        ber = np.zeros(self.N, dtype=np.float32)\n\
      \        logber = np.zeros(self.N, dtype=np.float32)\n\n        for i in range(self.N):\n\
      \            n = int(self.count[i])\n            e = int(self.errors[i])\n\n\
      \            if n <= 0:\n                ber[i] = 0.0\n                logber[i]\
      \ = 0.0\n            elif e > 0:\n                b = e/float(n)\n         \
      \       ber[i] = b\n                logber[i] = np.log10(max(b, 1e-12))\n  \
      \          else:\n                # BER observado = 0; para la gr\xE1fica usamos\
      \ una cota superior.\n                ber[i] = 0.0\n                upper =\
      \ min(1.0, 3.0/float(n))\n                logber[i] = np.log10(max(upper, 1e-12))\n\
      \n        return ber, logber\n\n    def work(self, input_items, output_items):\n\
      \        tx = input_items[0]\n        rx = input_items[1]\n        out_ber =\
      \ output_items[0]\n        out_log = output_items[1]\n\n        nout = len(out_ber)\n\
      \        D = self.update_every\n\n        for k in range(nout):\n          \
      \  a = k*D\n            b = min((k+1)*D, len(tx))\n            if a < b:\n \
      \               self._process(tx[a:b], rx[a:b])\n\n            ber, logber =\
      \ self._vectors()\n            out_ber[k, :] = ber\n            out_log[k, :]\
      \ = logber\n\n        return nout\n"
    affinity: ''
    alias: ''
    bits_guardia: bits_guardia
    bits_por_punto: bits_por_punto
    comment: ''
    delay_bits: delay_bits
    maxoutbuf: '0'
    minoutbuf: '0'
    update_every: update_every
  states:
    _io_cache: ('e_BER_Curve', 'blk', [('EbN0_min', '0.0'), ('EbN0_max', '14.0'),
      ('EbN0_step', '1.0'), ('bits_por_punto', '100000'), ('bits_guardia', '1000'),
      ('delay_bits', '0'), ('update_every', '1000')], [('0', 'byte', 1), ('1', 'byte',
      1)], [('0', 'float', 15), ('1', 'float', 15)], '', ['EbN0_max', 'EbN0_min',
      'EbN0_step', 'bits_guardia', 'bits_por_punto', 'delay_bits', 'update_every'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2000, 824.0]
    rotation: 0
    state: enabled
- name: e_Busca_Retardo
  id: epy_block
  parameters:
    _source_code: "\"\"\"\ne_Busca_Retardo (Grupo 1)\nHerramienta de apoyo para calibrar\
      \ delay_bits en el laboratorio.\n\nEntrada 0 : bits Tx de referencia (byte 0/1).\n\
      Entrada 1 : bits Rx recuperados (byte 0/1).\n\nAcumula 'n_bits' de cada secuencia\
      \ y calcula, por correlaci\xF3n cruzada (FFT),\nel retardo (en bits) que mejor\
      \ alinea Rx con Tx, entre 0 y 'max_lag'.\nImprime en la consola de GNU Radio\
      \ el retardo y la BER en ese retardo.\nSi la correlaci\xF3n es negativa, los\
      \ bits llegan invertidos (ambig\xFCedad de 180\xB0).\nSe repite cada 'n_bits'\
      \ bits.\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, n_bits=40000, max_lag=33000):\n        gr.sync_block.__init__(self,\
      \ name='e_Busca_Retardo',\n                               in_sig=[np.int8, np.int8],\
      \ out_sig=None)\n        self.n_bits = int(n_bits)\n        self.max_lag = int(max_lag)\n\
      \        self.tx = []\n        self.rx = []\n        self.total = self.n_bits\
      \ + self.max_lag\n\n    def work(self, input_items, output_items):\n       \
      \ self.tx.extend((input_items[0] & 1).tolist())\n        self.rx.extend((input_items[1]\
      \ & 1).tolist())\n        if len(self.tx) >= self.total and len(self.rx) >=\
      \ self.total:\n            tx = 2.0*np.array(self.tx[:self.total]) - 1.0\n \
      \           rx = 2.0*np.array(self.rx[self.max_lag:self.total]) - 1.0\n    \
      \        n = 1 << int(np.ceil(np.log2(len(tx) + len(rx))))\n            corr\
      \ = np.fft.irfft(np.fft.rfft(tx, n) * np.conj(np.fft.rfft(rx, n)), n)\n    \
      \        c = corr[:self.max_lag + 1][::-1] / len(rx)\n            k = int(np.argmax(np.abs(c)))\n\
      \            lag = k\n            ref = tx[self.max_lag - lag:self.max_lag -\
      \ lag + len(rx)]\n            ber = float(np.mean(np.sign(ref) != np.sign(rx)))\n\
      \            print(f\"[e_Busca_Retardo] delay_bits = {lag}  correlacion = {c[k]:+.3f}\
      \  BER en ese retardo = {ber:.3e}\"\n                  + (\"  (bits INVERTIDOS)\"\
      \ if c[k] < 0 else \"\"))\n            self.tx = self.tx[self.total:]\n    \
      \        self.rx = self.rx[self.total:]\n        return len(input_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    max_lag: '33000'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_bits: '40000'
  states:
    _io_cache: ('e_Busca_Retardo', 'blk', [('n_bits', '40000'), ('max_lag', '33000')],
      [('0', 'byte', 1), ('1', 'byte', 1)], [], '', ['max_lag', 'n_bits'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2016, 1028.0]
    rotation: 0
    state: enabled
- name: e_EbN0_Sweep
  id: epy_block
  parameters:
    EbN0_max: EbN0_max
    EbN0_min: EbN0_min
    EbN0_step: EbN0_step
    _source_code: "\"\"\"\ne_EbN0_Sweep\nInstrumento para caracterizaci\xF3n BER con\
      \ un enlace SDR ya funcional.\n\nEntrada 0 : se\xF1al compleja I/Q recibida\
      \ del SDR (preferiblemente DESPU\xC9S\n            de la adaptaci\xF3n radio_rate\
      \ -> bb_rate).\nSalida 0  : la misma se\xF1al I/Q con AWGN adicional controlado.\n\
      Salida 1  : valor instant\xE1neo de Eb/N0 [dB] usado en el barrido.\n\nEl bloque\
      \ NO sustituye el USRP/HackRF ni el receptor. Se inserta entre\nla salida I/Q\
      \ del SDR y la entrada del receptor digital.\n\nEl barrido se hace por segmentos\
      \ contiguos. Cada punto se mantiene durante:\n    bits_guardia + bits_por_punto\n\
      \nLa potencia de ruido artificial se calcula a partir de la potencia promedio\n\
      medida ANTES de agregar el ruido:\n\n    Eb = Ps / Rb\n    N0 = Eb / (Eb/N0)\n\
      \    Pn = N0 * Fs\n\npor lo tanto:\n\n    Pn = Ps * Fs / (Rb * 10**(EbN0_dB/10))\n\
      \nEl ruido complejo se genera con varianza total Pn.\n\"\"\"\n\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\n\
      \                 EbN0_min=0.0,\n                 EbN0_max=14.0,\n         \
      \        EbN0_step=1.0,\n                 samp_rate=256000.0,\n            \
      \     bit_rate=64000.0,\n                 bits_por_punto=100000,\n         \
      \        bits_guardia=1000,\n                 signal_power=0.0,\n          \
      \       seed=2026):\n        gr.sync_block.__init__(\n            self,\n  \
      \          name='e_EbN0_Sweep',\n            in_sig=[np.complex64],\n      \
      \      out_sig=[np.complex64, np.float32]\n        )\n\n        self.EbN0_min\
      \ = float(EbN0_min)\n        self.EbN0_max = float(EbN0_max)\n        self.EbN0_step\
      \ = float(EbN0_step)\n        self.samp_rate = float(samp_rate)\n        self.bit_rate\
      \ = float(bit_rate)\n        self.bits_por_punto = max(1, int(bits_por_punto))\n\
      \        self.bits_guardia = max(0, int(bits_guardia))\n        self.signal_power_cfg\
      \ = float(signal_power)\n\n        if self.EbN0_step <= 0:\n            raise\
      \ ValueError(\"EbN0_step debe ser > 0\")\n        if self.samp_rate <= 0 or\
      \ self.bit_rate <= 0:\n            raise ValueError(\"samp_rate y bit_rate deben\
      \ ser > 0\")\n        if self.EbN0_max < self.EbN0_min:\n            raise ValueError(\"\
      EbN0_max debe ser >= EbN0_min\")\n\n        npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step))\
      \ + 1\n        self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts,\
      \ dtype=np.float64)\n        self.segment_bits = self.bits_guardia + self.bits_por_punto\n\
      \n        self.sample_count = 0\n        self.power_sum = 0.0\n        self.power_count\
      \ = 0\n        self.rng = np.random.default_rng(int(seed))\n\n    def _signal_power(self,\
      \ x):\n        if self.signal_power_cfg > 0:\n            return self.signal_power_cfg\n\
      \n        # Promedio acumulado de la se\xF1al recibida ANTES del ruido artificial.\n\
      \        self.power_sum += float(np.sum(np.abs(x.astype(np.complex128))**2))\n\
      \        self.power_count += len(x)\n        if self.power_count <= 0:\n   \
      \         return 0.0\n        return max(self.power_sum/self.power_count, 1e-20)\n\
      \n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        y = output_items[0]\n        eb_out = output_items[1]\n        n =\
      \ len(x)\n        if n == 0:\n            return 0\n\n        Ps = self._signal_power(x)\n\
      \n        # \xCDndice absoluto de muestra -> \xEDndice equivalente de bit.\n\
      \        s = self.sample_count + np.arange(n, dtype=np.float64)\n        bit_index\
      \ = np.floor(s*self.bit_rate/self.samp_rate).astype(np.int64)\n\n        segment_index\
      \ = bit_index // self.segment_bits\n        point_index = np.mod(segment_index,\
      \ len(self.eb_axis))\n        ebn0_db = self.eb_axis[point_index]\n        ebn0_lin\
      \ = np.power(10.0, ebn0_db/10.0)\n\n        # Potencia total del ruido complejo\
      \ por muestra.\n        noise_power = Ps*self.samp_rate/(self.bit_rate*ebn0_lin)\n\
      \        sigma_iq = np.sqrt(np.maximum(noise_power, 0.0)/2.0)\n\n        noise\
      \ = (\n            self.rng.standard_normal(n)*sigma_iq\n            + 1j*self.rng.standard_normal(n)*sigma_iq\n\
      \        ).astype(np.complex64)\n\n        y[:] = x + noise\n        eb_out[:]\
      \ = ebn0_db.astype(np.float32)\n\n        self.sample_count += n\n        return\
      \ n\n"
    affinity: ''
    alias: ''
    bit_rate: Rb
    bits_guardia: bits_guardia
    bits_por_punto: bits_por_punto
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    seed: '2026'
    signal_power: '0.0'
  states:
    _io_cache: ('e_EbN0_Sweep', 'blk', [('EbN0_min', '0.0'), ('EbN0_max', '14.0'),
      ('EbN0_step', '1.0'), ('samp_rate', '256000.0'), ('bit_rate', '64000.0'), ('bits_por_punto',
      '100000'), ('bits_guardia', '1000'), ('signal_power', '0.0'), ('seed', '2026')],
      [('0', 'complex', 1)], [('0', 'complex', 1), ('1', 'float', 1)], '', ['EbN0_max',
      'EbN0_min', 'EbN0_step', 'bit_rate', 'bits_guardia', 'bits_por_punto', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 644.0]
    rotation: 0
    state: enabled
